ITESTRA_DASHBOARD_PORT=8080
# Ermöglicht das Abschneiden des Namens (10 letzen Zeichen bleiben) für einer ansehentliche Darstellung bei Anonymisierung
VITE_ANONYMIZE_NAMES=true

# MariaDB Datasource
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=itestraOfficeDashboard
DB_USER=myuser
DB_PASS=mypass
DB_ROOT_PASS=myadminpass

# Odoo integration
# HINWEIS: Die bisherigen Werte standen im Klartext in git und MÜSSEN rotiert werden.
# Nach der Rotation die neuen Werte hier eintragen (nur lokal, .env ist gitignored).
ODOO_API_URL=https://odoo15studentproject.dev.itestra.com
ODOO_API_DB=itestraodoo
ODOO_API_USERNAME=admin
ODOO_API_PASSWORD=REDACTED-SECRET

# Mattermost integration
# HINWEIS: Der bisherige Token stand im Klartext in git und MUSS rotiert werden.
# Nach der Rotation den neuen Token hier eintragen (nur lokal, .env ist gitignored).
MATTERMOST_API_URL=https://mattermost.itestra.com/api/v4
MATTERMOST_API_TOKEN=REDACTED-SECRET
MATTERMOST_API_CHANNEL_ID=REDACTED-SECRET
