DASHBOARD_PORT=8080
# Ermöglicht das Abschneiden des Namens (10 letzen Zeichen bleiben) für einer ansehentliche Darstellung bei Anonymisierung
VITE_ANONYMIZE_NAMES=true

# MariaDB Datasource
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=officeDashboard
DB_USER=myuser
DB_PASS=mypass
DB_ROOT_PASS=myadminpass

# Odoo integration (optional)
# Leer lassen, wenn keine Odoo-Anbindung genutzt wird — die Kalender-Events bleiben dann leer.
ODOO_API_URL=
ODOO_API_DB=
ODOO_API_USERNAME=admin
ODOO_API_PASSWORD=

# Mattermost integration (optional)
# Leer lassen, wenn keine Mattermost-Benachrichtigungen gewünscht sind.
MATTERMOST_API_URL=
MATTERMOST_API_TOKEN=
MATTERMOST_API_CHANNEL_ID=

# Admin credentials for the admin UI
# Choose a strong password and keep it secret.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REDACTED-SECRET

# CORS — comma-separated list of allowed origins for the admin UI
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8098
